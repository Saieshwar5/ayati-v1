{
  "apps": [
    {
      "id": "gmail",
      "category": "email_calendar",
      "description": "Email",
      "name": "Gmail",
      "providers": { "composio": "gmail", "pipedream": "gmail" },
      "identity": { "composio": { "tool": "GMAIL_GET_PROFILE", "field": "emailAddress" } },
      "actions": [
        {
          "id": "gmail.find_emails",
          "title": "Find emails",
          "effect": "read",
          "providers": {
            "composio": {
              "tool": "GMAIL_FETCH_EMAILS",
              "fields": { "query": "query", "max_results": "max_results", "page_token": "page_token" }
            },
            "pipedream": {
              "tool": "gmail-find-email",
              "fields": { "query": "q", "max_results": "maxResults" }
            }
          }
        },
        {
          "id": "gmail.draft_email",
          "title": "Draft an email",
          "effect": "write",
          "required": ["to"],
          "providers": {
            "composio": {
              "tool": "GMAIL_CREATE_EMAIL_DRAFT",
              "fields": { "to": "recipient_email", "cc": "cc", "bcc": "bcc", "subject": "subject", "body": "body", "is_html": "is_html", "thread_id": "thread_id" }
            },
            "pipedream": {
              "tool": "gmail-create-draft",
              "fields": { "to": "to", "subject": "subject", "body": "body" }
            }
          }
        },
        {
          "id": "gmail.send_email",
          "title": "Send an email",
          "effect": "write",
          "required": ["to", "subject", "body"],
          "providers": {
            "composio": {
              "tool": "GMAIL_SEND_EMAIL",
              "fields": { "to": "recipient_email", "cc": "cc", "bcc": "bcc", "subject": "subject", "body": "body", "is_html": "is_html" }
            },
            "pipedream": {
              "tool": "gmail-send-email",
              "fields": { "to": "to", "subject": "subject", "body": "body" }
            }
          }
        },
        {
          "id": "gmail.reply_to_thread",
          "title": "Reply in an email thread",
          "effect": "write",
          "required": ["thread_id", "body"],
          "providers": {
            "composio": {
              "tool": "GMAIL_REPLY_TO_THREAD",
              "fields": { "thread_id": "thread_id", "body": "message_body", "to": "recipient_email", "is_html": "is_html" }
            }
          }
        }
      ]
    },
    {
      "id": "google_calendar",
      "category": "email_calendar",
      "description": "Calendar",
      "name": "Google Calendar",
      "providers": { "composio": "googlecalendar", "pipedream": "google_calendar" },
      "identity": { "composio": { "tool": "GOOGLECALENDAR_GET_CALENDAR", "arguments": { "calendar_id": "primary" }, "field": "id" } },
      "actions": [
        {
          "id": "google_calendar.find_events",
          "title": "Find calendar events",
          "effect": "read",
          "providers": {
            "composio": {
              "tool": "GOOGLECALENDAR_FIND_EVENT",
              "fields": { "query": "query", "from": "time_min", "until": "time_max", "max_results": "max_results", "calendar_id": "calendar_id", "page_token": "page_token" }
            },
            "pipedream": {
              "tool": "google_calendar-list-events",
              "fields": { "query": "q", "from": "timeMin", "until": "timeMax", "max_results": "maxResults", "calendar_id": "calendarId" }
            }
          }
        },
        {
          "id": "google_calendar.create_event",
          "title": "Create a calendar event",
          "effect": "write",
          "required": ["title", "start"],
          "providers": {
            "composio": {
              "tool": "GOOGLECALENDAR_CREATE_EVENT",
              "fields": { "title": "summary", "description": "description", "location": "location", "start": "start_datetime", "end": "end_datetime", "timezone": "timezone", "duration_hours": "event_duration_hour", "duration_minutes": "event_duration_minutes", "calendar_id": "calendar_id", "notify": "send_updates", "attendees": "attendees" }
            },
            "pipedream": {
              "tool": "google_calendar-create-event",
              "fields": { "title": "summary", "description": "description", "location": "location", "start": "eventStartDate", "end": "eventEndDate", "timezone": "timeZone", "calendar_id": "calendarId" }
            }
          }
        }
      ]
    },
    {
      "id": "google_sheets",
      "category": "files",
      "description": "Spreadsheets",
      "name": "Google Sheets",
      "providers": { "composio": "googlesheets", "pipedream": "google_sheets" },
      "actions": [
        {
          "id": "google_sheets.find_row",
          "title": "Find a spreadsheet row",
          "effect": "read",
          "providers": {
            "composio": {
              "tool": "GOOGLESHEETS_LOOKUP_SPREADSHEET_ROW",
              "fields": { "spreadsheet_id": "spreadsheet_id", "query": "query", "range": "range", "case_sensitive": "case_sensitive" }
            }
          }
        },
        {
          "id": "google_sheets.spreadsheet_info",
          "title": "Read spreadsheet details",
          "effect": "read",
          "required": ["spreadsheet_id"],
          "providers": {
            "composio": {
              "tool": "GOOGLESHEETS_GET_SPREADSHEET_INFO",
              "fields": { "spreadsheet_id": "spreadsheet_id" }
            },
            "pipedream": {
              "tool": "google_sheets-get-spreadsheet-info",
              "fields": { "spreadsheet_id": "spreadsheetId" }
            }
          }
        }
      ]
    },
    {
      "id": "google_drive",
      "category": "files",
      "description": "Files and folders",
      "name": "Google Drive",
      "providers": { "composio": "googledrive", "pipedream": "google_drive" },
      "identity": { "composio": { "tool": "GOOGLEDRIVE_GET_ABOUT", "arguments": { "fields": "user" }, "field": "user.emailAddress" } },
      "actions": [
        {
          "id": "google_drive.find_files",
          "title": "Find files",
          "effect": "read",
          "providers": {
            "composio": {
              "tool": "GOOGLEDRIVE_FIND_FILE",
              "fields": { "query": "q", "folder_id": "folder_id", "page_size": "pageSize", "page_token": "pageToken", "order_by": "orderBy" }
            },
            "pipedream": {
              "tool": "google_drive-search-files",
              "fields": { "query": "query", "page_size": "maxResults", "page_token": "pageToken" }
            }
          }
        }
      ]
    }
  ]
}
