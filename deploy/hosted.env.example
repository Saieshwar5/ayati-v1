# Non-secret configuration only. Copy outside the tracked tree or into ignored .env.
AYATI_IMAGE=ayati:hosted-local
AYATI_PUBLIC_ORIGIN=https://workspace.example.com
AYATI_LOCAL_PORT=8765
WORKOS_CLIENT_ID=client_replace_me
AYATI_MODEL=replace-with-your-tested-model
AYATI_GOOSE_PROVIDER=openai
AYATI_WORKER_PROVIDERS=openai
AYATI_WORKER_CONCURRENCY=4
# Absolute, privately provisioned files readable by container UID 10001.
# Use a secrets manager in hosting; do not commit these files or paste their contents.
AYATI_DATABASE_URL_FILE=/private/ayati/runtime-database-url
AYATI_MIGRATION_DATABASE_URL_FILE=/private/ayati/migration-database-url
AYATI_WORKOS_API_KEY_FILE=/private/ayati/workos-api-key
AYATI_MODEL_API_KEY_FILE=/private/ayati/model-api-key
# Optional private object storage. Without it Library pages work; file uploads do not.
CUCKOO_LIBRARY_S3_BUCKET=
CUCKOO_LIBRARY_S3_ENDPOINT=
AWS_REGION=us-east-1
