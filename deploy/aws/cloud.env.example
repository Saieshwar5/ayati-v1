# Copy to deploy/aws/.env.cloud (ignored by Git). Non-secret settings only:
# provider keys go to Secrets Manager with `env.sh secret`.
AYATI_AWS_ACCOUNT=123456789012
AYATI_AWS_CLI_USER=cuckoo-cli
AYATI_ENV=ayati-dev
AYATI_DOMAIN=dev.cuckoo.onl
AYATI_HOSTNAME=app.dev.cuckoo.onl
AYATI_BUDGET_EMAIL=you@example.com
# WorkOS client ID (public); add https://app.dev.cuckoo.onl/auth/callback as a redirect URI in WorkOS.
AYATI_WORKOS_CLIENT_ID=client_replace_me
AYATI_MODEL=replace-with-your-tested-model
AYATI_MODEL_PROVIDER=openai
# Who may issue workspace invite codes (invite-only early access); comma-separated.
AYATI_PLATFORM_ADMINS=you@example.com
# Optional: controllers transcribe voice notes (runtime/voice-transcription.md). The
# provider must accept the model-api-key secret; recordings are sent to it.
# AYATI_TRANSCRIPTION_MODEL=fireworks-audio:whisper-v3-turbo
# AYATI_TRANSCRIPTION_BASE_URL=https://audio-prod.us-virginia-1.direct.fireworks.ai/v1
AYATI_CONTROLLERS=1
AYATI_EXECUTORS=1
# Fargate sizes (defaults: one test workspace, a few people, about five agents).
# Valid pairs: CPU 256 → memory 512-2048; 512 → 1024-4096; 1024 → 2048-8192.
# AYATI_CONTROLLER_CPU=256
# AYATI_CONTROLLER_MEMORY=512
# AYATI_EXECUTOR_CPU=512
# AYATI_EXECUTOR_MEMORY=1024
