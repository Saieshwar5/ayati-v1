{
  "name": "ayati-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:e2e": "tsc -p e2e/tsconfig.json",
    "test:e2e": "node e2e/run.ts",
    "test:live": "node e2e/run.ts --live",
    "test:report": "node e2e/run.ts --report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
