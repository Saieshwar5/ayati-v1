# Copy to .env and configure locally. Never send your API key in chat.
FIREWORKS_API_KEY=
AYATI_MODEL=accounts/fireworks/models/glm-5p3-flash
AYATI_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
AYATI_PORT=8765
AYATI_DATA_DIR=.ayati
# Conservative byte budget for the working context; model token counts vary.
AYATI_CONTEXT_BYTES=96000
