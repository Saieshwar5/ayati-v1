# Create .env locally. Never send API keys in chat.
AYATI_RUNTIME=goose
AYATI_GOOSE_PROVIDER=fireworks-ai
FIREWORKS_API_KEY=
AYATI_MODEL=accounts/fireworks/models/glm-5p3-flash
AYATI_GOOSE_BIN=.cache/goose/v1.54.0/goose
# Set vm after following the VM setup in README; host is the adapter-development mode.
AYATI_EXECUTION=host
# VM idle shutdown after this many seconds without work; 0 disables it.
AYATI_VM_IDLE_SECONDS=300
# Optional override for vm; the default is .ayati-local/vms/local-agent/vm.json.
# AYATI_VM_MANIFEST=.ayati-local/vms/local-agent/vm.json
# Optional harmless synthetic MCP tool, with owner Allow once / Deny:
AYATI_PROOF_TOOL=0
# Browser requires a new VM prepared with --browser; see README.
AYATI_BROWSER=0
# Optional sourced memory; see runtime/memory.md (new Goose tool configuration).
AYATI_MEMORY=0
# Composio manages provider credentials. A ck_ key uses Connect MCP; a project
# key uses Platform APIs. Keep either key host-only; see runtime/composio.md.
COMPOSIO_API_KEY=
# Signed event receiver. Configure a Composio webhook subscription separately.
COMPOSIO_WEBHOOK_SECRET=
AYATI_PORT=8765
AYATI_DATA_DIR=.ayati-local

# For AYATI_GOOSE_PROVIDER=openai, set OPENAI_API_KEY and a matching AYATI_MODEL.
# OPENAI_HOST and OPENAI_BASE_PATH may explicitly select a compatible test endpoint.
# OPENAI_BASE_PATH is the complete path, e.g. v1/chat/completions.

# Legacy prototype regression path only (AYATI_RUNTIME=prototype):
AYATI_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
AYATI_CONTEXT_BYTES=96000
# Local identity server (`ayati identity`), separate from the local agent server.
# Configure the default callback as http://127.0.0.1:8765/auth/callback in WorkOS.
# WORKOS_CLIENT_ID=client_...
# WORKOS_API_KEY=sk_...

# Optional PostgreSQL identity/shared-chat backend. Run migrations and offline import
# before enabling it. tools/local-postgres.sh env prints this machine's local URL.
# Keep connection credentials in .env only. See runtime/postgres-workspaces.md.
# RELAY_DATABASE_URL=postgresql://relay_app@localhost/relay_workspace?host=/absolute/private/socket&port=55432
# Shared agent execution: embedded preserves the existing single-process setup.
# Set external on `ayati identity` to queue work for separately started `ayati worker` processes.
# External execution requires PostgreSQL; workers use their own AYATI_DATA_DIR.
# AYATI_CHAT_EXECUTION=external
# AYATI_WORKER_CONCURRENCY=4
# For temporary local workers instead, set AYATI_CHAT_EXECUTION=assigned on the API
# and run `ayati assignment-launcher`. Requires PostgreSQL migration 15.
# See runtime/assignment-workers.md; accepted jobs retain their execution deadline.
# AYATI_ASSIGNMENT_RUN_SECONDS=180
# AYATI_ASSIGNMENT_LEASE_SECONDS=120
# AYATI_ASSIGNMENT_CAPACITY=2
# Opt-in same-host controller API instead of direct-PG assignment children.
# Set both on the controller/launcher; create the private key as in runtime/worker-control.md.
# AYATI_WORKER_CONTROL_URL=http://127.0.0.1:8766
# AYATI_WORKER_CONTROL_KEY_FILE=/absolute/private/worker-control.key
# Shared prepared slots: set AYATI_CHAT_EXECUTION=pooled on the controller and run
# `ayati executor` without DB/WorkOS secrets. See runtime/executor-pool.md.
# Requires migration 15 and the separate no-inference preparation variant:
# python3 tools/build-prepared-goose.py
# AYATI_PREPARED_GOOSE_BIN=/absolute/path/to/.cache/goose/v1.54.0-ayati.1/goose
# AYATI_EXECUTOR_SLOTS=2
# AYATI_EXECUTOR_CAPACITY=2
# AYATI_EXECUTOR_WORKSPACE_LIMIT=2
# AYATI_EXECUTOR_MODEL_LIMIT=2
# AYATI_EXECUTOR_EXPIRY_SECONDS=15
# Optional fixed-label startup timings on controller and executor (no prompt/keys).
# Requires RUST_LOG=ayati=info; includes fixed-label handoff timestamp points.
# See runtime/load-acceptance.md and runtime/bounded-agent-load.md.
# AYATI_TRACE_START=1
# Public deployment only, behind a trusted TLS proxy; see runtime/hosted-deployment.md.
# AYATI_PUBLIC_ORIGIN=https://workspace.example.com
# AYATI_BIND_ADDRESS=0.0.0.0
# Advertise providers actually configured on the independent workers, without copying their keys here.
# AYATI_WORKER_PROVIDERS=openai
# Optional worker supervisor probe. Parent directory must already exist and be private.
# AYATI_WORKER_HEALTH_FILE=/absolute/private/worker.health

# Optional Library file storage. Pages work without it. See runtime/library.md.
# Use a private bucket and configure AWS credentials privately on the server.
# CUCKOO_LIBRARY_S3_BUCKET=your-private-bucket
# AWS_REGION=your-region
# CUCKOO_LIBRARY_S3_ENDPOINT=https://your-s3-compatible-endpoint
# Explicit local development alternative; do not enable both backends:
# CUCKOO_LIBRARY_LOCAL_ROOT=/absolute/private/development/library-files
