# Create .env locally. Never send API keys in chat.
AYATI_RUNTIME=goose
AYATI_GOOSE_PROVIDER=fireworks-ai
FIREWORKS_API_KEY=
AYATI_MODEL=accounts/fireworks/models/glm-5p3-flash
AYATI_GOOSE_BIN=.cache/goose/v1.54.0/goose
# Set vm after following the VM setup in README; host is the adapter-development mode.
AYATI_EXECUTION=host
# VM idle shutdown after this many seconds without work; 0 disables it.
AYATI_VM_IDLE_SECONDS=300
# Optional override for vm; the default is .ayati-local/vms/local-agent/vm.json.
# AYATI_VM_MANIFEST=.ayati-local/vms/local-agent/vm.json
# Optional harmless synthetic MCP tool, with owner Allow once / Deny:
AYATI_PROOF_TOOL=0
# Browser requires a new VM prepared with --browser; see README.
AYATI_BROWSER=0
# Optional sourced memory; see runtime/memory.md (new Goose tool configuration).
AYATI_MEMORY=0
# Composio manages connected-account OAuth credentials. Keep this host key private.
COMPOSIO_API_KEY=
AYATI_PORT=8765
AYATI_DATA_DIR=.ayati-local

# For AYATI_GOOSE_PROVIDER=openai, set OPENAI_API_KEY and a matching AYATI_MODEL.
# OPENAI_HOST and OPENAI_BASE_PATH may explicitly select a compatible test endpoint.
# OPENAI_BASE_PATH is the complete path, e.g. v1/chat/completions.

# Legacy prototype regression path only (AYATI_RUNTIME=prototype):
AYATI_MODEL_BASE_URL=https://api.fireworks.ai/inference/v1
AYATI_CONTEXT_BYTES=96000
