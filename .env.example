# Create .env locally. Never send API keys in chat.
AYATI_GOOSE_PROVIDER=fireworks-ai
FIREWORKS_API_KEY=
AYATI_MODEL=accounts/fireworks/models/glm-5p3-flash
AYATI_GOOSE_BIN=.cache/goose/v1.54.0/goose
# Optional harmless synthetic MCP tool, with owner Allow once / Deny:
AYATI_PROOF_TOOL=0
# Optional reviewed shared-agent remote MCP profiles, controller-only.
# See runtime/shared-agent-control.md; never commit the profile or bearer files.
# AYATI_MCP_SERVERS_FILE=/absolute/private/servers.json
AYATI_PORT=8765
AYATI_DATA_DIR=.ayati-local

# For AYATI_GOOSE_PROVIDER=openai, set OPENAI_API_KEY and a matching AYATI_MODEL.
# OPENAI_HOST and OPENAI_BASE_PATH may explicitly select a compatible test endpoint.
# OPENAI_BASE_PATH is the complete path, e.g. v1/chat/completions.

# Controller (`ayati identity`).
# Configure the default callback as http://127.0.0.1:8765/auth/callback in WorkOS.
# WORKOS_CLIENT_ID=client_...
# WORKOS_API_KEY=sk_...

# Optional PostgreSQL identity/shared-chat backend. Run migrations and offline import
# before enabling it. tools/local-postgres.sh env prints this machine's local URL.
# Keep connection credentials in .env only. See runtime/postgres-workspaces.md.
# RELAY_DATABASE_URL=postgresql://relay_app@localhost/relay_workspace?host=/absolute/private/socket&port=55432
# Agent replies run on pooled executors (`ayati executor`) through worker control.
# Set both on the controller and every executor; create the key as in runtime/worker-control.md.
# AYATI_WORKER_CONTROL_URL=http://127.0.0.1:8766
# AYATI_WORKER_CONTROL_KEY_FILE=/absolute/private/worker-control.key
# Executors need the no-inference preparation variant and no DB/WorkOS secrets:
# python3 tools/build-prepared-goose.py
# AYATI_PREPARED_GOOSE_BIN=/absolute/path/to/.cache/goose/v1.54.0-ayati.1/goose
# AYATI_EXECUTOR_SLOTS=2
# AYATI_EXECUTOR_CAPACITY=2
# AYATI_ASSIGNMENT_RUN_SECONDS=180
# AYATI_ASSIGNMENT_LEASE_SECONDS=120
# AYATI_PUBLIC_ORIGIN=https://workspace.example.com
# AYATI_BIND_ADDRESS=0.0.0.0
# Advertise providers actually configured on the executors, without copying their keys here.
# AYATI_WORKER_PROVIDERS=openai

# Optional Library file storage. Pages work without it. See runtime/library.md.
# Use a private bucket and configure AWS credentials privately on the server.
# CUCKOO_LIBRARY_S3_BUCKET=your-private-bucket
# AWS_REGION=your-region
# CUCKOO_LIBRARY_S3_ENDPOINT=https://your-s3-compatible-endpoint
# Explicit local development alternative; do not enable both backends:
# CUCKOO_LIBRARY_LOCAL_ROOT=/absolute/private/development/library-files
