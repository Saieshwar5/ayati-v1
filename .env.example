# Controller settings (`ayati identity`). Copy to .env locally; never commit secrets
# or send API keys in chat. Executors read .env.executor instead (see
# .env.executor.example) and refuse the database and WorkOS secrets below.
# Unknown AYATI_/RELAY_/CUCKOO_ names are reported as warnings at startup.
AYATI_PORT=8765
AYATI_DATA_DIR=.ayati-local

# Sign-in. Configure http://127.0.0.1:8765/auth/callback in WorkOS.
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=

# Run migrations first; `tools/local-postgres.sh env` prints this machine's URL.
# See runtime/postgres-workspaces.md.
RELAY_DATABASE_URL=

# Agent replies run on pooled executors through worker control. Create the key as
# in runtime/worker-control.md and give executors the same two settings.
AYATI_WORKER_CONTROL_URL=http://127.0.0.1:8766
AYATI_WORKER_CONTROL_KEY_FILE=/absolute/private/worker-control.key
# Providers configured on the executors; their keys stay on the executors.
AYATI_WORKER_PROVIDERS=fireworks-ai
# Default model for new agents.
AYATI_MODEL=accounts/fireworks/models/glm-5p3-flash
# Pool policy (defaults shown); see runtime/executor-pool.md for every setting.
# AYATI_EXECUTOR_CAPACITY=2
# AYATI_ASSIGNMENT_RUN_SECONDS=180
# AYATI_ASSIGNMENT_LEASE_SECONDS=120

# The setup assistant and job samples still run Goose on the controller.
AYATI_GOOSE_PROVIDER=fireworks-ai
AYATI_GOOSE_BIN=.cache/goose/v1.54.0/goose
FIREWORKS_API_KEY=
# For openai, set OPENAI_API_KEY; OPENAI_HOST and OPENAI_BASE_PATH (the complete
# path, e.g. v1/chat/completions) may select a compatible test endpoint.

# Optional reviewed remote MCP profiles; see runtime/shared-agent-control.md.
# AYATI_MCP_SERVERS_FILE=/absolute/private/servers.json

# Optional Library file storage; pages work without it. See runtime/library.md.
# Use a private bucket and configure AWS credentials privately on the server.
# CUCKOO_LIBRARY_S3_BUCKET=your-private-bucket
# AWS_REGION=your-region
# CUCKOO_LIBRARY_S3_ENDPOINT=https://your-s3-compatible-endpoint
# Local development alternative; do not enable both backends:
# CUCKOO_LIBRARY_LOCAL_ROOT=/absolute/private/development/library-files

# On stop, report not ready for this long before closing (use 15 behind a load
# balancer), and give up on unfinished work after the second limit.
# AYATI_DRAIN_SECONDS=0
# AYATI_SHUTDOWN_SECONDS=60

# Hosted only: HTTPS origin behind a TLS proxy.
# AYATI_PUBLIC_ORIGIN=https://workspace.example.com
# AYATI_BIND_ADDRESS=0.0.0.0
