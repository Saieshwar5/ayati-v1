# Executor settings (`ayati executor`). Copy to .env.executor locally. Executors
# never receive database, WorkOS, connector or Library settings.
AYATI_DATA_DIR=.ayati-local/executor-one
AYATI_WORKER_CONTROL_URL=http://127.0.0.1:8766
AYATI_WORKER_CONTROL_KEY_FILE=/absolute/private/worker-control.key
# On AWS ECS: prove the task identity instead of using the bootstrap key file
# (see runtime/worker-control.md); then leave AYATI_WORKER_CONTROL_KEY_FILE unset.
# AYATI_EXECUTOR_IDENTITY=aws
# For an https:// URL, the private certificate authority to trust (only):
# AYATI_WORKER_CONTROL_CA=/absolute/private/worker-control-tls/ca.pem

# One immutable provider/model profile per executor.
AYATI_GOOSE_PROVIDER=fireworks-ai
AYATI_MODEL=accounts/fireworks/models/glm-5p3-flash
FIREWORKS_API_KEY=
# For openai, set OPENAI_API_KEY; OPENAI_HOST and OPENAI_BASE_PATH (the complete
# path, e.g. v1/chat/completions) may select a compatible test endpoint.
# AYATI_EXECUTOR_SLOTS=2

# Plain Goose for tool runs; the no-inference preparation variant for ready slots
# (build it with python3 tools/build-prepared-goose.py).
AYATI_GOOSE_BIN=.cache/goose/v1.54.0/goose
AYATI_PREPARED_GOOSE_BIN=.cache/goose/v1.54.0-ayati.1/goose
