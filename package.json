{
  "name": "ayati",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Ayati product built on a manually upgraded OpenClaw source baseline",
  "engines": { "node": "26.2.0" },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "setup:runtime": "node bin/setup-runtime.mjs",
    "build": "pnpm --dir vendor/openclaw build",
    "build:runtime": "OPENCLAW_RUN_NODE_SKIP_DTS_BUILD=1 pnpm --dir vendor/openclaw build",
    "init": "node bin/ayati.mjs init",
    "start": "node bin/ayati.mjs start",
    "openclaw": "node bin/ayati.mjs openclaw",
    "check": "node bin/check-baseline.mjs && node bin/check-source-scope.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:gateway": "node tests/gateway-smoke.mjs"
  }
}
