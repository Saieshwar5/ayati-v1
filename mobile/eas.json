{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CUCKOO_ORIGIN": "http://127.0.0.1:8765"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_CUCKOO_UNIVERSAL_LINKS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CUCKOO_UNIVERSAL_LINKS": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
