{
  "expo": {
    "name": "Cuckoo",
    "slug": "cuckoo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F4F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cuckoo opens your photos only when you choose one to share in a conversation.",
          "cameraPermission": "Cuckoo uses the camera only when you take a photo to share in a conversation.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Cuckoo uses the microphone only while you record a voice note."
        }
      ]
    ],
    "scheme": "cuckoo"
  }
}
